rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Registrations collection (patient applications & therapy tests)
    match /registrations/{document=**} {
      allow read, write: if true;
    }

    // Users collection (user profiles & roles)
    match /users/{document=**} {
      allow read, write: if true;
    }

    // Usernames mapping (for username-based logins)
    match /usernames/{document=**} {
      allow read, write: if true;
    }

    // Recorded Eye Tracking Test Results & Telemetry Sessions
    match /testResults/{document=**} {
      allow read, write: if true;
    }

    // Admin Registrations collection (pending hospital staff & ophthalmologist admin applications)
    match /adminRegistrations/{document=**} {
      allow read, write: if true;
    }

    match /testSessions/{document=**} {
      allow read, write: if true;
    }
  }
}
